# ---------------------------------------------------------------------------
# Credenciais da conta que fara a navegacao (leitura apenas).
# Copie este arquivo para .env e preencha. O .env NUNCA e versionado.
# ---------------------------------------------------------------------------
IG_USERNAME=seu_usuario_sem_arroba
IG_PASSWORD=sua_senha

# Chave da API da Anthropic — habilita o agente analista especialista.
# Sem ela o sistema cai no motor lexical offline (funciona, porem mais raso).
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Comportamento humano da navegacao
# ---------------------------------------------------------------------------
# lento = mais seguro e mais parecido com gente de verdade
HUMAN_PACE=normal          # calmo | normal | apressado
HEADLESS=false             # false = Chrome visivel (recomendado, parece uso real)

# Entrar a mao na janela do Chrome em vez de preencher o formulario sozinho.
# Use isto se o Instagram recusar o login automatico dizendo "senha incorreta"
# mesmo com a senha certa — e uma defesa anti-robo dele, nao um erro seu.
# Voce entra uma vez, a sessao fica salva e as proximas analises sao diretas.
LOGIN_MANUAL=false

# ---------------------------------------------------------------------------
# Quando o Instagram recusa o login automatico
# ---------------------------------------------------------------------------
# Ele responde "informacoes incorretas" a navegador automatizado mesmo com a
# senha certa. As duas saidas abaixo dispensam a tela de login. Use uma.

# 1) Aproveitar a sessao do seu Chrome do dia a dia (mais simples).
#    O sistema copia so os cookies para uma pasta propria, entao o Chrome
#    pode continuar aberto e nada do seu navegador e alterado.
#    Windows: C:\Users\SEU_USUARIO\AppData\Local\Google\Chrome\User Data
#    Mac:     /Users/SEU_USUARIO/Library/Application Support/Google/Chrome
CHROME_PROFILE=
CHROME_PROFILE_NAME=Default

# 2) Colar o cookie de sessao de um navegador ja autenticado.
#    No Chrome logado: F12 > Application > Cookies > instagram.com > sessionid
IG_SESSIONID=
MAX_POSTS=40               # teto de publicacoes lidas por analise
MAX_COMMENTS_PER_POST=150  # teto de comentarios lidos por publicacao
SESSION_DIR=./sessions     # onde o login e reaproveitado entre execucoes

# Caminho do Chrome, se nao estiver no local padrao (opcional)
CHROME_PATH=
