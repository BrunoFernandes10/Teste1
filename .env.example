# ---------------------------------------------------------------------------
# Credenciais da conta que fara a navegacao (leitura apenas).
# Copie este arquivo para .env e preencha. O .env NUNCA e versionado.
# ---------------------------------------------------------------------------
IG_USERNAME=seu_usuario_sem_arroba
IG_PASSWORD=sua_senha

# Chave da API da Anthropic — habilita o agente analista especialista.
# Sem ela o sistema cai no motor lexical offline (funciona, porem mais raso).
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Comportamento humano da navegacao
# ---------------------------------------------------------------------------
# lento = mais seguro e mais parecido com gente de verdade
HUMAN_PACE=normal          # calmo | normal | apressado
HEADLESS=false             # false = Chrome visivel (recomendado, parece uso real)
MAX_POSTS=40               # teto de publicacoes lidas por analise
MAX_COMMENTS_PER_POST=150  # teto de comentarios lidos por publicacao
SESSION_DIR=./sessions     # onde o login e reaproveitado entre execucoes

# Caminho do Chrome, se nao estiver no local padrao (opcional)
CHROME_PATH=
